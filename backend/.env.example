# ── Database ───────────────────────────────────────────────────
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# ── JWT ────────────────────────────────────────────────────────
JWT_SECRET=

# ── AI Provider Key (OPTIONAL — server fallback only) ──────────
# Users bring their own keys via Settings (BYOK).
# This key is only used as fallback for users without their own.
GEMINI_API_KEY=

# ── SMTP (optional, for OTP emails) ────────────────────────────
MAIL_USERNAME=
MAIL_PASSWORD=

# ── OAuth2 (optional) ──────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
