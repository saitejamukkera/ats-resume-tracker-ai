# ── Database ───────────────────────────────────────────────────
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# ── JWT ────────────────────────────────────────────────────────
JWT_SECRET=

# ── AI Provider Keys (OPTIONAL — server fallback only) ─────────
# Users bring their own keys via Settings → AI Provider (BYOK).
# These are fallback keys for users who haven't configured their own.
# Leave blank if you want BYOK-only mode.
LLM_PROVIDER=google              # google | openai | anthropic
# GOOGLE_GENERATIVE_AI_API_KEY=  # Google Gemini (for server fallback)
# OPENAI_API_KEY=                 # OpenAI (for server fallback)
# ANTHROPIC_API_KEY=              # Anthropic (for server fallback)

# ── App / Cookie Security (production) ─────────────────────────
FRONTEND_URL=http://localhost:3000  # e.g. https://trackhireai.com
COOKIE_DOMAIN=                   # e.g. trackhireai.com  (shared root domain)
COOKIE_SECURE=false              # true in production (HTTPS)
COOKIE_SAME_SITE=Lax             # None when frontend & API are cross-origin

# ── SMTP (optional, for OTP emails) ────────────────────────────
MAIL_USERNAME=
MAIL_PASSWORD=

# ── OAuth2 (optional) ──────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Semantic ATS Scoring (Phase 3) ──────────────────────────────
# Set to "false" to disable SBERT embeddings (saves ~80MB disk + ~200MB RAM).
# When enabled, the resume-pipeline downloads the all-MiniLM-L6-v2 model
# on first startup and caches it in a Docker volume (hf_cache).
ENABLE_SEMANTIC_SCORING=true

# ── Admin Analytics ──────────────────────────────────────────
ADMIN_API_KEY=your_secret_admin_api_key_here

