# ── Database ───────────────────────────────────────────────────
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# ── JWT ────────────────────────────────────────────────────────
JWT_SECRET=

# ── AI Provider Keys (OPTIONAL — server fallback only) ─────────
# Users bring their own keys via Settings → AI Provider (BYOK).
# These are fallback keys for users who haven't configured their own.
# Leave blank if you want BYOK-only mode.
LLM_PROVIDER=google              # google | openai | anthropic
# GOOGLE_GENERATIVE_AI_API_KEY=  # Google Gemini (for server fallback)
# OPENAI_API_KEY=                 # OpenAI (for server fallback)
# ANTHROPIC_API_KEY=              # Anthropic (for server fallback)

# ── Cookie Security (production) ───────────────────────────────
COOKIE_DOMAIN=                   # e.g. .trackhireai.com
COOKIE_SECURE=false              # true in production

# ── SMTP (optional, for OTP emails) ────────────────────────────
MAIL_USERNAME=
MAIL_PASSWORD=

# ── OAuth2 (optional) ──────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
