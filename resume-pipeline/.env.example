# ── LLM Provider (server fallback only) ────────────────────────
# Users bring their own keys via Settings → AI Provider (BYOK).
# This provider is only used when no user key is provided.
LLM_PROVIDER=google

# ── Provider Keys (OPTIONAL — server fallback only) ────────────
# Leave blank if you want BYOK-only mode.
# Google Gemini (if LLM_PROVIDER=google):
# GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-api-key
# OpenAI (if LLM_PROVIDER=openai):
# OPENAI_API_KEY=sk-...
# Anthropic (if LLM_PROVIDER=anthropic):
# ANTHROPIC_API_KEY=sk-ant-...

# ── Server ─────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Semantic ATS Scoring (Phase 3) ──────────────────────────────
# Enabled by default. Requires ~80MB model download on first run.
# Set to "false" to disable (e.g. in Docker environments without internet).
# ENABLE_SEMANTIC_SCORING=true


# ── Admin Analytics ──────────────────────────────────────────
ADMIN_API_KEY=your_secret_admin_api_key_here

